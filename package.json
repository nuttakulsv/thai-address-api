{
  "name": "thai-address-api",
  "version": "0.1.0",
  "description": "Thai provinces, districts, sub-districts and postcodes as an offline library and a small HTTP API. Parses free-text Thai addresses.",
  "keywords": [
    "thailand",
    "thai",
    "address",
    "postcode",
    "province",
    "amphoe",
    "tambon",
    "geocoding",
    "autocomplete",
    "hono"
  ],
  "author": "nuttakulsv",
  "license": "MIT",
  "homepage": "https://github.com/nuttakulsv/thai-address-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuttakulsv/thai-address-api.git"
  },
  "bugs": "https://github.com/nuttakulsv/thai-address-api/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "thai-address-api": "./dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsx watch src/server/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts examples",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "tsx scripts/bench.ts",
    "demo:build": "tsx scripts/build-demo.ts",
    "data:build": "tsx scripts/build-data.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
