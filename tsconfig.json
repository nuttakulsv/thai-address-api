{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "thai-address-api": ["./src/index.ts"],
      "thai-address-api/server": ["./src/server/app.ts"]
    }
  },
  "include": ["src", "test", "scripts", "examples/*.ts", "tsup.config.ts"]
}
